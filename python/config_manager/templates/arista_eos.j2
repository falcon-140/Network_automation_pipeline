! ---------------------------------------------------------
! Managed by network-automation-pipeline. Do not edit by hand.
! Device: {{ hostname }}  Site: {{ site }}  Role: {{ role }}
! ---------------------------------------------------------
hostname {{ hostname }}
!
{% for iface in interfaces | default([]) %}
interface {{ iface.name }}
   description {{ iface.description | default('managed-by-pipeline') }}
   ip address {{ iface.ip }}/{{ iface.prefix_len | default(24) }}
{% if iface.enabled | default(true) %}
   no shutdown
{% else %}
   shutdown
{% endif %}
!
{% endfor %}
{% for neighbor in bgp_neighbors | default([]) %}
router bgp {{ local_asn }}
   neighbor {{ neighbor.ip }} remote-as {{ neighbor.asn }}
   neighbor {{ neighbor.ip }} description {{ neighbor.description | default('') }}
!
{% endfor %}
management api http-commands
   no shutdown
!
logging host {{ syslog_server | default('10.0.0.254') }}
ntp server {{ ntp_server | default('pool.ntp.org') }}
end
